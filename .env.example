# LLM Importance Gate — DeepSeek V4 Flash
# Copy this to .env and fill in your API key

IMPORTANCE_API_BASE=https://api.deepseek.com/v1
IMPORTANCE_API_KEY=sk-your-api-key-here
IMPORTANCE_MODEL=deepseek-v4-flash
IMPORTANCE_THRESHOLD=0.3
IMPORTANCE_TIMEOUT=5

# Memory Skill Configuration
# MEMORY_MODEL_PATH=models/bge-large-en-v1.5     # Default: auto-detected (models/bge-large-en-v1.5)
# MEMORY_IMPORTANCE_GATE=llm                      # "rule" (default) or "llm" (needs API key above)
# MEMORY_SKILL_DB_PATH=memory.db                  # Default: memory.db
# MEMORY_SKILL_LOG_LEVEL=WARNING                  # DEBUG, INFO, WARNING, ERROR
